<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for Supabase client config.

  Copy this file to `Supabase.plist` (same folder) and fill in your project's
  values, then re-run `cd ios && xcodegen generate`. `Supabase.plist` is
  git-ignored — never commit real keys.

  Only the ANON / publishable key goes here (safe to ship: Row Level Security
  restricts each user to their own row). NEVER put the service_role key or DB
  password in this file or anywhere in the app.

  If `Supabase.plist` is absent, the app runs local-only (no cross-platform sync).
-->
<plist version="1.0">
<dict>
    <key>SUPABASE_URL</key>
    <string>YOUR_PROJECT_URL</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>YOUR_ANON_KEY</string>
</dict>
</plist>
