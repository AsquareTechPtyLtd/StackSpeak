# Sample Android local config. Copy to `local.properties` and fill in real values.
# `local.properties` is GIT-IGNORED — never commit real keys.
#
# Android Studio auto-writes sdk.dir on first project open; you can also set it:
# sdk.dir=/Users/<you>/Library/Android/sdk

# Supabase client config — the anon/publishable key + project URL.
# Safe to ship in the app: Row Level Security restricts each user to their own row.
# Find these in Supabase dashboard -> Settings -> API, or mirror the iOS
# Supabase.plist. The service_role key and DB password must NEVER go here.
supabase.url=https://YOUR-PROJECT-ref.supabase.co
supabase.anon_key=YOUR_PUBLISHABLE_OR_ANON_KEY
