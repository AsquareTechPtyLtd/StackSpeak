<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Minimal framework theme (no AppCompat/Material-Components dep needed —
         Compose draws the UI). Just sets the pre-Compose window background and a
         transparent status bar for edge-to-edge. -->
    <style name="Theme.StackSpeak" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
